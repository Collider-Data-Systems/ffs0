# Personal Google account for the Keep -> Drive mirror (gkeepapi).
# Copy to secrets/keep_personal.env (gitignored) and fill in real values.
# The master token is as sensitive as your password — never commit it, never paste it in chat.
#
# Getting a master token (once): use a trusted gpsoauth helper on a machine you control,
# e.g. `python -c "import gpsoauth; print(gpsoauth.perform_master_login(email, password, android_id))"`
# with an app password if 2FA is on. See dev/scripts/keep-anywhere/README.md.
KEEP_EMAIL=you@gmail.com
KEEP_MASTER_TOKEN=REPLACE_ME
