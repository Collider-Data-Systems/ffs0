# Factory API Keys - Copy to api_keys.env and fill in values
# DO NOT commit api_keys.env!

# moos local development database password (required by platform/presets/windows-local-dev.json)
MOOS_DB_PASSWORD=

# Google AI Studio (Gemini)
GEMINI_API_KEY=

# Google Cloud (for Vertex AI)
GOOGLE_APPLICATION_CREDENTIALS=D:/HPZ440/ffs0/secrets/gcp-service-account.json

# Google Calendar OAuth writer (local-only files; do not commit real JSON)
GOOGLE_CALENDAR_OAUTH_CLIENT=C:/Users/maass/HPlaptop/ffs0/secrets/google_calendar_oauth_client.json
GOOGLE_CALENDAR_OAUTH_TOKEN=C:/Users/maass/HPlaptop/ffs0/secrets/google_calendar_token.json

# OpenAI (optional)
OPENAI_API_KEY=

# Anthropic (optional)
ANTHROPIC_API_KEY=sk-ant-...

# GitHub Personal Access Token (for Antigravity GitHub MCP server)
# Scopes needed: repo, read:org, read:user, project
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...