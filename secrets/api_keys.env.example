# Factory API Keys — copy to api_keys.env (gitignored) and fill in values.
# DO NOT commit api_keys.env!
#
# PREFERRED (T=239, #64 resolved): you usually DON'T need this file. Provider keys live in
#   Google Secret Manager and load into env via `. dev\scripts\ops\Get-Secrets.ps1` (keyless,
#   via ADC). Gemini Flash via Vertex needs no key at all. This file is now an OFFLINE FALLBACK
#   only. Identity = `gh auth login` (keyring) + `gcloud auth login` (ADC).
#   See secrets/README.md "Resolved architecture" + dev/config/model-providers.json.
#
# Design note (T=226, ffs0#64): keep this file's secret surface near-zero.
#   - GitHub  -> NO token here; git/gh use the OS keyring (`gh auth login`).
#   - Google  -> keyless ADC + domain-wide-delegation (DWD); no SA JSON key
#                and no long-lived OAuth token files on disk.
# What legitimately remains a file secret is provider API keys you actually
# use locally plus any Cloudflare Access service-token creds.

# --- GitHub ---------------------------------------------------------------
# Nothing here. Authenticate once per machine with `gh auth login` (device/web
# flow); the token lands in the OS credential store, is per-machine, and is
# independently revocable from github.com/settings/tokens. Do NOT paste a PAT
# (ghp_/gho_) into this file — see secrets/README.md "GitHub auth".

# --- Provider API keys (file secrets that genuinely live here) ------------
# Google AI Studio (Gemini) — primary provider
GEMINI_API_KEY=

# OpenAI (optional — add when needed)
OPENAI_API_KEY=

# Anthropic (optional — add when needed)
ANTHROPIC_API_KEY=

# --- Google Cloud / Calendar / Keep — KEYLESS, no key files --------------
# Project context (not secret, kept here for convenience)
GCP_PROJECT_ID=
GCP_REGION=

# Application Default Credentials via `gcloud auth application-default login`
# (authorized_user). This is the keyless path — do NOT point this at a
# downloaded gcp-service-account.json key. Path is machine-local.
GOOGLE_APPLICATION_CREDENTIALS=

# Calendar writer + Keep ingest run on the keyless DWD service-account path
# (IAM signJwt -> delegated token for sam@my-tiny-data-collider.nl), NOT on
# per-user OAuth token files. See secrets/README.md "Keyless Google (DWD)".

# --- moos local kernel ----------------------------------------------------
# Only required if MOOS_KERNEL_STORE=postgres (windows-local-dev preset)
MOOS_DB_PASSWORD=

# --- Cloudflare Access (the main remaining file secret, if used locally) --
# Service-token client id/secret for CF Access-protected endpoints. Leave
# blank unless this machine drives a CF Access lane.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
