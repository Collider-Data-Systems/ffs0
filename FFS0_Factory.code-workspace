{
  "folders": [
    {
      "path": ".",
      "name": "FFS0_Factory (root)"
    },
    {
      "path": ".agent",
      "name": "Agent Workspace"
    },
    {
      "path": "../moos",
      "name": "mo:os Kernel (code)"
    }
  ],
  "settings": {
    "task.allowAutomaticTasks": "on",
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "golang.go",
    "[go]": {
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
      }
    },
    "[markdown]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "files.exclude": {
      "**/.git": false,
      "**/*.exe": true,
      "**/*.exe~": true,
      "**/moos.exe": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/node_modules": true
    },
    "search.exclude": {
      "**/.agent/skills": true,
      "**/platform/kernel/data": true,
      "**/platform/kernel/boot*.err": true
    },
    "go.lintOnSave": "package",
    "go.lintTool": "golangci-lint",
    "python.defaultInterpreterPath": "${workspaceFolder:FFS0_Factory (root)}/.venv/Scripts/python.exe",
    "python.interpreterPath": "${workspaceFolder:FFS0_Factory (root)}/.venv/Scripts/python.exe",
    "go.lintFlags": [
      "--fast"
    ],
    "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    }
  },
  "extensions": {
    "recommendations": [
      "golang.go",
      "esbenp.prettier-vscode",
      "ms-vscode.makefile-tools",
      "redhat.vscode-yaml",
      "DavidAnson.vscode-markdownlint"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Kernel (with --kb --hydrate)",
        "type": "go",
        "request": "launch",
        "mode": "debug",
        "program": "${workspaceFolder:mo:os Kernel (code)}/platform/kernel/cmd/moos",
        "cwd": "${workspaceFolder:mo:os Kernel (code)}/platform/kernel",
        "args": [
          "--kb",
          "${workspaceFolder:Agent Workspace}/kb",
          "--hydrate"
        ],
        "showLog": true
      },
      {
        "name": "Kernel (no hydrate)",
        "type": "go",
        "request": "launch",
        "mode": "debug",
        "program": "${workspaceFolder:mo:os Kernel (code)}/platform/kernel/cmd/moos",
        "cwd": "${workspaceFolder:mo:os Kernel (code)}/platform/kernel",
        "args": [
          "--kb",
          "${workspaceFolder:Agent Workspace}/kb"
        ],
        "showLog": true
      },
      {
        "name": "Kernel (--mcp-stdio)",
        "type": "go",
        "request": "launch",
        "mode": "debug",
        "program": "${workspaceFolder:mo:os Kernel (code)}/platform/kernel/cmd/moos",
        "cwd": "${workspaceFolder:mo:os Kernel (code)}/platform/kernel",
        "args": [
          "--kb",
          "${workspaceFolder:Agent Workspace}/kb",
          "--hydrate",
          "--mcp-stdio"
        ],
        "showLog": true
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Kernel: build",
        "type": "shell",
        "command": "go",
        "args": [
          "build",
          "-o",
          "moos.exe",
          "./cmd/moos"
        ],
        "options": {
          "cwd": "${workspaceFolder:mo:os Kernel (code)}/platform/kernel"
        },
        "problemMatcher": [
          "$go"
        ],
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false
        }
      },
      {
        "label": "Kernel: test all",
        "type": "shell",
        "command": "go",
        "args": [
          "test",
          "./..."
        ],
        "options": {
          "cwd": "${workspaceFolder:mo:os Kernel (code)}/platform/kernel"
        },
        "problemMatcher": [
          "$go"
        ],
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false
        }
      },
      {
        "label": "Kernel: run (with --kb --hydrate)",
        "type": "shell",
        "command": "go",
        "args": [
          "run",
          "./cmd/moos",
          "--kb",
          "${workspaceFolder:Agent Workspace}/kb",
          "--hydrate"
        ],
        "options": {
          "cwd": "${workspaceFolder:mo:os Kernel (code)}/platform/kernel"
        },
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": true
        }
      },
      {
        "label": "Git: pull latest",
        "type": "shell",
        "command": "git",
        "args": [
          "pull",
          "origin",
          "main"
        ],
        "options": {
          "cwd": "${workspaceFolder:mo:os Kernel (code)}"
        },
        "presentation": {
          "echo": true,
          "reveal": "always"
        }
      },
      {
        "label": "KB: open CLAUDE.md",
        "type": "shell",
        "command": "code",
        "args": [
          "${workspaceFolder:Agent Workspace}/CLAUDE.md"
        ],
        "presentation": {
          "reveal": "silent"
        }
      },
      {
        "label": "Auto: ensure kernel running",
        "type": "shell",
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "$h = $null; try { $h = Invoke-RestMethod 'http://localhost:8000/healthz' -TimeoutSec 2 } catch {}; if ($null -eq $h -or $h.status -ne 'ok') { Start-Process -FilePath 'powershell' -WindowStyle Hidden -ArgumentList @('-NoLogo','-NoProfile','-ExecutionPolicy','Bypass','-Command','Set-Location ''${workspaceFolder:mo:os Kernel (code)}\\platform\\kernel''; go run ./cmd/moos --kb ''${workspaceFolder:Agent Workspace}\\kb'' --hydrate *>> ''${workspaceFolder:Agent Workspace}\\dev\\vscode-kernel-autostart.log''') | Out-Null; Write-Output 'Kernel start requested.' } else { Write-Output 'Kernel already healthy.' }"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "never",
          "panel": "dedicated"
        }
      },
      {
        "label": "Auto: ensure antigraviti listener",
        "type": "shell",
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "$p = Get-CimInstance Win32_Process | Where-Object { $_.Name -match 'pwsh|powershell' -and $_.CommandLine -match 'antigraviti-auto-listen' -and $_.CommandLine -notmatch 'vscode-ai' } | Select-Object -First 1; if ($null -eq $p) { Start-Process -FilePath 'pwsh' -WindowStyle Hidden -ArgumentList @('-NoLogo','-NoProfile','-ExecutionPolicy','Bypass','-File','${workspaceFolder:Agent Workspace}\\dev\\antigraviti-auto-listen.ps1','-AgentUrn','urn:moos:agent:antigraviti','-AgentTag','antigraviti','-AssignedTo','antigraviti','-MutexName','Local\\FFS0_Antigraviti_AutoListen','-StartFromNow') | Out-Null; Write-Output 'Antigraviti listener started.' } else { Write-Output 'Antigraviti listener already running.' }"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "never",
          "panel": "dedicated"
        }
      },
      {
        "label": "Auto: startup bootstrap",
        "dependsOrder": "sequence",
        "dependsOn": [
          "Auto: ensure kernel running",
          "Auto: ensure antigraviti listener"
        ],
        "runOptions": {
          "runOn": "folderOpen"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "never",
          "panel": "dedicated"
        }
      }
    ]
  }
}