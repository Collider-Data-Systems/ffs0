{
  "folders": [
    {
      "path": ".",
      "name": "ffs0-private-workspace",
    },
  ],
  "settings": {
    "task.allowAutomaticTasks": "off",
    "[markdown]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[powershell]": {
      "editor.defaultFormatter": "ms-vscode.powershell",
    },
    "files.exclude": {
      "**/.git": false,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/node_modules": true,
    },
    "search.exclude": {
      "**/dev/reference/**": true,
    },
  },
  "extensions": {
    "recommendations": [
      "esbenp.prettier-vscode",
      "redhat.vscode-yaml",
      "DavidAnson.vscode-markdownlint",
      "ms-vscode.powershell",
    ],
  },
}
