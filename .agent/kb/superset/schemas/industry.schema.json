{
    "$id": "https://moos.factory/schemas/industry.schema.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Mo:os Industry Schema",
    "description": "S0 gate for industry/*.json files. Requires source traceability to sources.json and explicit ontology_targets mapping. Every industry file must declare what OBJ types its entries feed.",
    "type": "object",
    "required": [
        "domain",
        "source",
        "ontology_targets",
        "entries"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "schema_version": {
            "type": "string"
        },
        "domain": {
            "type": "string",
            "minLength": 1,
            "description": "Industry domain name (e.g. providers, benchmarks, compute, protocols, tools, frameworks, features)"
        },
        "source": {
            "type": "string",
            "pattern": "^urn:moos:source:",
            "description": "URN of the authoritative source from sources.json (e.g. urn:moos:source:artificial-analysis)"
        },
        "ontology_targets": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "pattern": "^OBJ[0-9]{2}$"
            },
            "description": "OBJ IDs from ontology.json that this industry file feeds. Must match the source's feeds[] array."
        },
        "description": {
            "type": "string"
        },
        "provenance": {
            "type": "object",
            "properties": {
                "curated_by": {
                    "type": "string",
                    "description": "Agent or person who curated this data"
                },
                "curated_date": {
                    "type": "string",
                    "format": "date",
                    "description": "ISO date of last curation"
                },
                "intake_task": {
                    "type": "string",
                    "description": "Task ID that produced this file (e.g. 20260317-031)"
                },
                "source_query": {
                    "type": "string",
                    "description": "Query or method used to harvest this data"
                }
            }
        },
        "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Industry-level identifier (format varies by domain)"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string",
                        "enum": ["active", "deprecated", "preview", "discontinued"]
                    }
                },
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": true
}