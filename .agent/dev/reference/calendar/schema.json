{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Google Calendar Reference Entry",
  "type": "object",
  "required": [
    "id",
    "source_type",
    "retrieved_at",
    "summary",
    "start_time",
    "end_time"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cal:[a-zA-Z0-9]+$"
    },
    "source_type": {
      "type": "string",
      "const": "google_calendar"
    },
    "retrieved_at": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp"
    },
    "summary": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "organizer": {
      "type": "string"
    },
    "attendees": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
