{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Google Task Reference Entry",
  "type": "object",
  "required": [
    "id",
    "source_type",
    "retrieved_at",
    "title",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^task:[a-zA-Z0-9]+$"
    },
    "source_type": {
      "type": "string",
      "const": "google_tasks"
    },
    "retrieved_at": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp"
    },
    "title": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["needsAction", "completed"]
    },
    "due": {
      "type": "string",
      "description": "ISO-8601 RFC3339 timestamp"
    },
    "completed_at": {
      "type": "string"
    },
    "tasklist_id": {
      "type": "string"
    }
  }
}
