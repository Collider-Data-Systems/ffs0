{
	"servers": {
		"moos-mcp-z440-lead": {
			"type": "stdio",
			"command": "${workspaceFolder:ffs0-private-workspace}/dev/tools/moos-mcp/moos-mcp.exe",
			"args": [
				"--base-url",
				"http://localhost:8000",
				"--actor",
				"urn:moos:agent:vscode.hp-z440.primary",
				"--auth-token-file",
				"${workspaceFolder:ffs0-private-workspace}/secrets/moos-auth-token"
			]
		},
		"moos-mcp-karpathy": {
			"type": "stdio",
			"command": "${workspaceFolder:ffs0-private-workspace}/dev/tools/moos-mcp/moos-mcp.exe",
			"args": [
				"--base-url",
				"http://localhost:8000",
				"--actor",
				"urn:moos:agent:vscode.hp-z440.lola",
				"--auth-token-file",
				"${workspaceFolder:ffs0-private-workspace}/secrets/moos-auth-token"
			]
		},
		"moos-hp-laptop-primary": {
			"type": "sse",
			"url": "http://localhost:8080/sse",
			"headers": {
				"Authorization": "Bearer <contents of secrets/moos-auth-token>"
			}
		},
		"moos-hpprodesk-primary": {
			"type": "sse",
			"url": "http://localhost:8080/sse",
			"headers": {
				"Authorization": "Bearer <contents of secrets/moos-auth-token>"
			}
		},
		"moos-primary": {
			"type": "sse",
			"url": "http://localhost:8080/sse",
			"headers": {
				"Authorization": "Bearer <contents of secrets/moos-auth-token>"
			}
		},
		"moos-menno": {
			"type": "sse",
			"url": "http://localhost:9001/sse",
			"headers": {
				"Authorization": "Bearer <contents of secrets/moos-auth-token>"
			}
		},
		"moos-lola": {
			"type": "sse",
			"url": "http://localhost:9002/sse",
			"headers": {
				"Authorization": "Bearer <contents of secrets/moos-auth-token>"
			}
		},
		"moos-moos": {
			"type": "sse",
			"url": "http://localhost:9003/sse",
			"headers": {
				"Authorization": "Bearer <contents of secrets/moos-auth-token>"
			}
		},
		"moos-kernel-cloud": {
			"type": "sse",
			"url": "https://kernel.my-tiny-data-collider.nl/sse",
			"headers": {
				"CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
				"CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
			}
		},
		"moos-api-cloud": {
			"type": "http",
			"url": "https://api.my-tiny-data-collider.nl",
			"headers": {
				"CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
				"CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
			}
		}
	}
}
