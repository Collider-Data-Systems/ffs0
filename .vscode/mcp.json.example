{
	"servers": {
		"_comment_local": "Local kernels. Active Z440 emits use moos-primary (:8080) until §M9 twin_link sync. Menno (:9001) and lola (:9002) are opens-on topology/future direct endpoints.",
		"moos-primary": {
			"type": "sse",
			"url": "http://localhost:8080/sse"
		},
		"moos-menno": {
			"type": "sse",
			"url": "http://localhost:9001/sse"
		},
		"moos-lola": {
			"type": "sse",
			"url": "http://localhost:9002/sse"
		},
		"moos-moos": {
			"type": "sse",
			"url": "http://localhost:9003/sse"
		},
		"_comment_cloud": "Cloud access via Cloudflare Zero Trust — set CF_ACCESS_CLIENT_ID and CF_ACCESS_CLIENT_SECRET env vars",
		"moos-kernel-cloud": {
			"type": "sse",
			"url": "https://kernel.my-tiny-data-collider.nl/sse",
			"headers": {
				"CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
				"CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
			}
		},
		"moos-api-cloud": {
			"type": "http",
			"url": "https://api.my-tiny-data-collider.nl",
			"headers": {
				"CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
				"CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
			}
		}
	}
}
