{
  "mcpServers": {
    "moos-kernel-cloud": {
      "type": "sse",
      "url": "https://kernel.my-tiny-data-collider.nl/sse",
      "headers": {
        "CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "moos-api-cloud": {
      "type": "http",
      "url": "https://api.my-tiny-data-collider.nl",
      "headers": {
        "CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
      }
    }
  }
}
