# Secrets — never commit secret values
secrets/api_keys.env
secrets/*.env
!secrets/*.env.example
secrets/client_secret_*.json
secrets/google_token.json
secrets/*oauth_client*.json
secrets/*token*.json

# Subrepo — has its own git repo
moos/

# Python / Node generated
.venv/
__pycache__/
*.pyc
node_modules/
*.egg-info/
dist/
build/

# LaTeX build artifacts
dev/.papers/**/*.aux
dev/.papers/**/*.log
dev/.papers/**/*.out
dev/.papers/**/*.pag
dev/.papers/**/*.bbl
dev/.papers/**/*.blg
dev/.papers/**/*.fls
dev/.papers/**/*.fdb_latexmk
dev/.papers/**/*.synctex.gz

# Temp and scratch
tmp/
scratch/

# Root-level issue/scratch captures from local review sessions
/issue*.txt
/issue*-comment-body.md
/ag-laptop-issue*-comment.md
/parse_log.py

# Machine-specific IDE configs (ports differ per workstation)
.vscode/mcp.json
.vscode/settings.json
*.local.code-workspace
*.tmp
lost\ converstation*.txt
tempprg.json
C:*

# Workspace root temp files — root-anchored (never commit loose files dumped here)
/data/
/*.ps1
/*.json
!/.mcp.json
/*.ics
/stream.txt

# Ephemeral local state (not portable)
data/morphism-log.jsonl
data/morphism-log.jsonl.bak*
dev/.antigraviti-auto-listener-state.json
dev/antigraviti-auto-listen.log
dev/.vscode-ai-auto-listener-state.json
dev/vscode-ai-auto-listen.log
dev/vscode-kernel-autostart.log
dev/wave*.json
dev/prg*-program.json
robocopy_log*.txt

# Local workstation customizations (not portable)
.github/skills/
.agents/mcp-bridge.js
.agents/*.js

# Build/backup binaries — never committable (B2 as mechanism, not discipline).
# Mirrors moos-kernel/.gitignore; that repo's equivalent guard landed as moos-kernel#67.
# No tracked file matches these patterns (verified t274: git ls-files | grep -E '\.exe~$|\.exe\.bak|\.exe$' -> empty).
*.exe~
*.exe.bak*

# OS
.DS_Store
Thumbs.db
