# Secrets — never commit (entire directory)
.agent/secrets/api_keys.env
.agent/secrets/client_secret_*.json
.agent/secrets/google_token.json

# Subrepo — has its own git repo
moos/

# Python / Node generated
.venv/
__pycache__/
*.pyc
node_modules/
*.egg-info/
dist/
build/

# LaTeX build artifacts
.agent/.papers/**/*.aux
.agent/.papers/**/*.log
.agent/.papers/**/*.out
.agent/.papers/**/*.pag
.agent/.papers/**/*.bbl
.agent/.papers/**/*.blg
.agent/.papers/**/*.fls
.agent/.papers/**/*.fdb_latexmk
.agent/.papers/**/*.synctex.gz

# Temp and scratch
tmp/
*.tmp
lost\ converstation*.txt
.agent/tempprg.json
.agent/C:*

# Workspace root temp files — root-anchored (never commit loose files dumped here)
/data/
/*.ps1
/*.json
/*.ics
/stream.txt

