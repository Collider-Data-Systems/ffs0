{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "YouTube Reference Entry",
    "type": "object",
    "required": [
        "id",
        "source_type",
        "source_url",
        "retrieved_at",
        "title",
        "channel",
        "language",
        "summary",
        "keywords",
        "transcript"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^yt:[a-z0-9-]+$"
        },
        "source_type": {
            "type": "string",
            "const": "youtube"
        },
        "source_url": {
            "type": "string",
            "pattern": "^https://(www\\.)?youtube\\.com/watch\\?v=|^https://youtu\\.be/"
        },
        "retrieved_at": {
            "type": "string",
            "description": "ISO-8601 UTC timestamp"
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "channel": {
            "type": "string",
            "minLength": 1
        },
        "language": {
            "type": "string",
            "minLength": 2
        },
        "duration_seconds": {
            "type": "number",
            "minimum": 0
        },
        "summary": {
            "type": "string",
            "minLength": 1
        },
        "keywords": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "claims": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "transcript": {
            "type": "string",
            "minLength": 1
        },
        "notes": {
            "type": "string"
        }
    }
}